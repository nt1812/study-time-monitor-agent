# Database Configuration
DATABASE_URL=postgresql://user:password@localhost:5432/study_monitor
MONGODB_URL=mongodb://localhost:27017/study_monitor

# Redis Configuration
REDIS_URL=redis://localhost:6379/0

# API Keys
OPENAI_API_KEY=your_openai_api_key_here
ANTHROPIC_API_KEY=your_anthropic_api_key_here

# Education Platform Integrations
COURSERA_API_KEY=your_coursera_api_key
UDEMY_API_KEY=your_udemy_api_key
EDXONLINE_API_KEY=your_edx_api_key

# Flask Configuration
FLASK_ENV=development
FLASK_DEBUG=True
SECRET_KEY=your_secret_key_here

# Agent Configuration
AGENT_LOG_LEVEL=INFO
AGENT_MODEL=gpt-4
AGENT_TEMPERATURE=0.7

# Monitoring Configuration
STUDY_CHECK_INTERVAL=300
ALERT_THRESHOLD_MINUTES=1800
